# Local development environment template
# Usage: copy this file to .env, then replace every your_* value locally.
# Never commit the generated .env file.

# Database
DB_HOST=your_db_host
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=journaling_materials_hub

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT (at least 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=604800000

# WeChat Mini Program
WECHAT_APPID=your_wechat_mini_program_app_id
WECHAT_SECRET=your_wechat_mini_program_app_secret

# MinIO
MINIO_ENDPOINT=http://your_minio_host:9000
MINIO_PUBLIC_ENDPOINT=https://your_public_file_domain/files
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=materials

# Admin console
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_bcrypt_admin_password_hash
ADMIN_TOKEN_EXPIRATION=86400000

# Business settings
FREE_DOWNLOAD_LIMIT=50

# WeChat Official Account message probe (plaintext callback only)
WECHAT_OFFICIAL_APP_ID=your_official_account_app_id
WECHAT_OFFICIAL_APP_SECRET=your_official_account_app_secret
WECHAT_OFFICIAL_TOKEN=your_random_callback_token
WECHAT_OFFICIAL_PROBE_API_ENABLED=false
WECHAT_PROBE_MAX_FILE_SIZE=10485760
WECHAT_PROBE_CONNECT_TIMEOUT_MS=5000
WECHAT_PROBE_READ_TIMEOUT_MS=15000
WECHAT_PROBE_MAX_REDIRECTS=3
WECHAT_PROBE_EXECUTOR_CORE_SIZE=2
WECHAT_PROBE_EXECUTOR_MAX_SIZE=4
WECHAT_PROBE_EXECUTOR_QUEUE_CAPACITY=100
