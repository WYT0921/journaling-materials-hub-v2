# 开发环境配置模板
# 使用方法：复制此文件为 application-dev.yml，填入真实配置值
# cp application-dev.yml.example application-dev.yml

# 管理员配置（用户 ID 列表，逗号分隔）
admin:
  user-ids: 1,6

# MinIO 配置
minio:
  endpoint: http://your-server-ip:9000
  access-key: your_minio_access_key
  secret-key: your_minio_secret_key
  bucket: materials

spring:
  datasource:
    url: jdbc:mysql://your-server-ip:3306/journaling_materials_hub?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_db_password
  data:
    redis:
      host: your-server-ip
      port: 6379
      password: your_redis_password

# 微信小程序配置
wechat:
  appid: your_wechat_appid
  secret: your_wechat_secret

# 开发环境日志级别
logging:
  level:
    root: INFO
    com.journaling.hub: DEBUG
    org.springframework.web: DEBUG
    org.springframework.security: DEBUG

# 开发环境 API 文档
springdoc:
  swagger-ui:
    path: /swagger-ui.html
