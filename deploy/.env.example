# Docker environment example
# Copy this file to .env and fill in real values.

# Database on host machine
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=journaling_materials_hub

# Redis on host machine
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# WeChat mini program
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# MinIO
# endpoint: internal address used by backend containers.
MINIO_ENDPOINT=http://host.docker.internal:9000
# public-endpoint: public URL returned to the mini program/admin frontend.
MINIO_PUBLIC_ENDPOINT=https://shouzhangku.store/files
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# Admin console account
# Generate the password hash with BCrypt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_admin_password_hash
ADMIN_TOKEN_EXPIRATION=86400000
