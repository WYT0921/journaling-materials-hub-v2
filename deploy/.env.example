# Docker 环境变量配置
# 使用方法：cp .env.example .env 并填入真实值

# ── 数据库（宿主机已有 MySQL）──
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=journaling_materials_hub

# ── Redis（宿主机已有）──
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ── JWT ──
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# ── 微信小程序 ──
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ── MinIO（宿主机已有）──
# endpoint：容器内部访问 MinIO 的地址
MINIO_ENDPOINT=http://host.docker.internal:9000
# public-endpoint：返回给小程序/前端的公开访问地址（nginx 代理或 MinIO 公网地址）
MINIO_PUBLIC_ENDPOINT=https://shouzhangku.store/files
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ── 管理员账号（网页管理后台登录）──
# 密码哈希通过 BCrypt.hashpw("your_password") 生成
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_admin_password_hash
ADMIN_TOKEN_EXPIRATION=86400000
